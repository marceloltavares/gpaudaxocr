@model BankCheckOCR.Models.CheckResult

@{
    ViewData["Title"] = "Resultado da Análise";
}

<div class="container mt-4">
    <h2>Resultado da Análise</h2>

    <div class="mb-3">
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </div>

    @if (Model.Success)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Dados Extraídos</h5>
            </div>
            <div class="card-body">
                <table class="table table-striped table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Campo</th>
                            <th>Valor Identificado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>CMC7</strong></td>
                            <td>@(string.IsNullOrEmpty(Model.CMC7) ? "Não identificado" : Model.CMC7)</td>
                        </tr>
                        <tr>
                            <td><strong>Código do Banco</strong></td>
                            <td>@(string.IsNullOrEmpty(Model.BankCode) ? "Não identificado" : Model.BankCode)</td>
                        </tr>
                        <tr>
                            <td><strong>Valor (R$)</strong></td>
                            <td>@(string.IsNullOrEmpty(Model.Amount) ? "Não identificado" : Model.Amount)</td>
                        </tr>
                        <tr>
                            <td><strong>Data</strong></td>
                            <td>@(string.IsNullOrEmpty(Model.Date) ? "Não identificado" : Model.Date)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
                <h6 class="mb-0" data-bs-toggle="collapse" href="#rawTextCollapse" role="button" aria-expanded="false" aria-controls="rawTextCollapse">
                    Ver Texto Bruto (OCR) <span class="small float-end">▼</span>
                </h6>
            </div>
            <div class="collapse" id="rawTextCollapse">
                <div class="card-body bg-light">
                    <pre>@Model.RawText</pre>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <h4>Erro na Análise</h4>
            <p>@Model.ErrorMessage</p>
        </div>
    }
</div>
